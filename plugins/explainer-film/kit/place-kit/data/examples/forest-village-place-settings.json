{
 "about": "An EXAMPLE place-settings.json for a village in a forest: dirt lanes cut by carts, a few cottages, an empty stable, scattered old props. Copy the shape, never the content: the names, roads and numbers below are this example's own. Every key is optional; an empty file means a lived-in place, dry, every role from object names. Numbers marked invented in the skill's example file are first tries to confirm.",
 "place": "forest village",
 "place_type": "village",
 "look": "lived_in",
 "state": "damp",
 "seed": 7,
 "look_by_role": {"ground.dirt_road": "neglected", "ground.forest_floor": "neglected", "prop.*": "neglected"},
 "owners": "forest-village-ownership.json",
 "roles": [
  {"role": "ground.dirt_road", "match": {"names": ["^Lane"]}},
  {"role": "ground.forest_floor", "match": {"names": ["^Ground", "^Verge"]}},
  {"role": "wall.plaster", "match": {"names": ["^Cottage .* wall$"]}},
  {"role": "roof.thatch", "match": {"names": ["^Cottage .* roof$"]}},
  {"role": "timber.door", "match": {"names": ["door$"]}},
  {"role": "timber.post", "match": {"names": ["post"]}},
  {"role": "timber.beam", "match": {"names": ["beam"]}},
  {"role": "stone.footing", "match": {"names": ["footing"]}},
  {"role": "stone.well", "match": {"names": ["^Prop well"]}},
  {"role": "prop.barrel", "match": {"names": ["^Prop barrel"]}},
  {"role": "prop.cart", "match": {"names": ["^Prop cart$"]}},
  {"role": "prop.wheel", "match": {"names": ["wheel"]}},
  {"role": "tree.bark", "match": {"names": ["^Tree", "^Stump", "^Log"]}},
  {"role": "never.glow", "match": {"names": ["window light"]}}
 ],
 "never": [
  {"role": "never.helper", "match": {"names": ["^Helper"]}, "reason": "a measuring helper that is hidden in every picture"}
 ],
 "off": [
  {"layer": "moss_and_algae", "roles": ["floor.planks", "floor.tile", "floor.carpet", "floor.earth", "floor.concrete"], "reason": "inside the buildings: dry, nothing grows", "reason_id": "floors_indoors"},
  {"layer": "weathering", "roles": ["floor.planks", "floor.tile", "floor.carpet", "floor.earth", "floor.concrete"], "reason": "inside the buildings: dry, nothing grows", "reason_id": "floors_indoors"},
  {"layer": "wetness", "roles": ["floor.planks", "floor.tile", "floor.carpet", "floor.earth", "floor.concrete"], "reason": "inside the buildings: dry, nothing grows", "reason_id": "floors_indoors"},
  {"layer": "plants", "roles": ["floor.planks", "floor.tile", "floor.carpet", "floor.earth", "floor.concrete"], "reason": "inside the buildings: dry, nothing grows", "reason_id": "floors_indoors"},
  {"layer": "litter_pieces", "roles": ["floor.planks", "floor.tile", "floor.carpet", "floor.earth", "floor.concrete"], "reason": "inside the buildings: dry, nothing grows", "reason_id": "floors_indoors"}
 ],
