#!/bin/bash
# What this does: sets up the explainer-film kit in a working folder: copies the kit (engine, tools,
# templates, examples, docs) there, installs the drawing engine's packages with npm, and checks what the
# tools need: Python's packages, ffmpeg, a Chromium browser, the Blender program and a virtual screen (for
# places built in 3D), a soundtrack, and whether the person's own rented-card settings are there (it only
# says yes or no: it never prints, reads or copies a value). It writes what it found about this machine into the kit's
# machine-settings.env (BLENDER, BLENDER_DISPLAY), which check-shot.sh and the checker's tests read, and
# checks that every kit file the plugin's skills name (paper-film, narration-tools, examples, docs, place-kit) is in the kit.
# With Blender found it prints a "Blender 5.2 probe" block: which way of setting a Geometry Nodes modifier input works in this Blender,
# and how a collection's light-linking entries pair with its objects (kit/place-kit/probe_blender.py). When the project's film kit
# is on this machine it lists the film kit files changed after the plugin's last copy (the newest date in kit/kit-sync-notes.md).
# Safe to run again: it never overwrites a kit file that already exists in the folder, so your own pages
# and pictures are kept; files that differ from the plugin's copy are listed in kit-differences.txt.
# machine-settings.env is rewritten each time (run it again after installing something).
#
# Use: explainer-film-setup /path/to/work/film-kit
#   BLENDER=/path/to/blender explainer-film-setup ...   to name the Blender program if it isn't found
set -u
USE="Use: explainer-film-setup /path/to/work/film-kit   (copies the kit into that folder; never overwrites a file already there)"
# a word that starts with - is an option, not a folder: --help prints the use line; anything else stops before a folder is made
case "${1:-}" in
  -h|--help) echo "$USE"; exit 0 ;;
  -*) echo "explainer-film-setup: \"$1\" is not a folder (it starts with -). $USE" >&2; exit 2 ;;
esac
TARGET="${1:?$USE}"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p -- "$TARGET" || { echo "explainer-film-setup: cannot make the folder $TARGET. Nothing was copied." >&2; exit 2; }
TARGET="$(cd -- "$TARGET" 2>/dev/null && pwd)" || { echo "explainer-film-setup: cannot open the folder $TARGET. Nothing was copied." >&2; exit 2; }
if [ -z "$TARGET" ] || [ "$TARGET" = "/" ]; then
  echo "explainer-film-setup: will not set up the kit in the top folder of the computer (/). Name a folder for the kit. Nothing was copied." >&2; exit 2
fi
# copy the kit without overwriting anything already there; list the files that differ from the plugin's
: > "$TARGET/kit-differences.txt"
(cd "$HERE/kit" && find . -type f ! -name '*.pyc' ! -path '*/__pycache__/*' | while read -r f; do
  if [ ! -e "$TARGET/$f" ]; then mkdir -p "$TARGET/$(dirname "$f")"; cp "$f" "$TARGET/$f"
  elif ! cmp -s "$f" "$TARGET/$f"; then echo "${f#./}" >> "$TARGET/kit-differences.txt"; fi
done)
mkdir -p "$TARGET/assets/reliefs" "$TARGET/assets/paintings" "$TARGET/assets/models" "$TARGET/assets/soundtrack" "$TARGET/paper-film/pieces" "$TARGET/paper-film/out"
echo "kit copied to $TARGET"
differ=$(wc -l < "$TARGET/kit-differences.txt")
[ "$differ" -gt 0 ] && echo "  $differ kit files there differ from the plugin's copy and were kept: see $TARGET/kit-differences.txt"
# a kept older copy of these files lacks the place stage and the place checks: say so by name (the setup never overwrites your files)
for important in calculators/preflight.py calculators/place_audit_check.py calculators/picture_measures.py film-settings.json; do
  if grep -qx "$important" "$TARGET/kit-differences.txt"; then
    echo "  NOTE: your $important is not the plugin's current one and was kept, so it may lack the place stage or the place numbers (version 1.4.0). To get them: cp \"$HERE/kit/$important\" \"$TARGET/$important\" (after saving your own changes)"
  fi
done
if [ ! -d "$TARGET/paper-film/node_modules/three" ]; then
  (cd "$TARGET/paper-film" && npm install --no-audit --no-fund) || echo "npm install failed: install Node.js 18+ and run 'npm install' in $TARGET/paper-film"
fi

echo "--- checks ---"
command -v ffmpeg >/dev/null && echo "ffmpeg: ok" || echo "ffmpeg: MISSING (install ffmpeg with libx264)"
python3 -c "import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)" 2>/dev/null && echo "python: ok ($(python3 --version 2>&1))" || echo "python: 3.10 or newer is needed (this is $(python3 --version 2>&1))"
python3 -c "import numpy, PIL, cv2" 2>/dev/null && echo "python packages: ok" || echo "python packages: MISSING (pip install numpy pillow opencv-python-headless)"
browser=$(cd "$TARGET" && node -e "import('./paper-film/tools/find-browser.mjs').then((m) => console.log(m.findBrowser())).catch(() => {})" 2>/dev/null)
if [ -n "$browser" ]; then echo "browser: ok ($browser)"
else echo "browser: MISSING (cd $TARGET/paper-film && npx playwright-core install chromium, or set PAPER_FILM_BROWSER)"; fi

# Blender: the full program (plates with EEVEE, the shot checker); BLENDER wins, then the PATH, then usual places
blender="${BLENDER:-}"
if [ -z "$blender" ]; then blender=$(command -v blender || true); fi
if [ -z "$blender" ]; then
  for candidate in "$HOME"/blender*/blender "$HOME"/*/blender-*-linux-x64/blender "$HOME"/*/*/blender-*-linux-x64/blender \
                   /opt/blender*/blender /usr/local/blender*/blender /Applications/Blender.app/Contents/MacOS/Blender; do
    [ -x "$candidate" ] && { blender="$candidate"; break; }
  done
fi
if [ -n "$blender" ] && [ -x "$blender" ]; then
  version=$("$blender" --version 2>/dev/null | head -1)
  echo "blender (for places built in 3D and the shot checker): ok (${version:-unknown version}, $blender)"
  # Blender's own Python has numpy but normally no Pillow; the place kit and model_kit.py need none (pictures are written as PNG)
  if "$blender" -b --disable-autoexec --python-exit-code 3 --python-expr "import PIL" >/dev/null 2>&1; then
    echo "  blender's own Python has Pillow (the place kit does not need it)"
  else
    echo "  blender's own Python has no Pillow: normal, the place kit and model_kit.py need none (a script that draws text with Pillow does: run that part outside Blender)"
  fi
  # Blender 5.2 traps: which way works in THIS Blender (a Geometry Nodes modifier input set both ways; one light-linking pairing read back)
  probe=$("$blender" -b --disable-autoexec --python "$HERE/kit/place-kit/probe_blender.py" 2>/dev/null | sed -n '/^Blender 5.2 probe/,/^  light linking/p')
  if [ -n "$probe" ]; then echo "$probe"; else echo "Blender 5.2 probe: it could not be run with $blender (see kit/place-kit/probe_blender.py)"; fi
else
  blender=""
  echo "blender (optional, for places built in 3D and the shot checker): not found. Download Blender 5.2 or newer"
  echo "  from https://www.blender.org/download/, then run again with BLENDER=/path/to/blender"
fi
# a virtual screen: EEVEE needs one on a machine without a graphics card
display="${BLENDER_DISPLAY:-:96}"
if [ -e "/tmp/.X11-unix/X${display#:}" ]; then echo "virtual screen: $display is running"
elif command -v Xvfb >/dev/null; then echo "virtual screen: Xvfb found but $display is not running; start it with: Xvfb $display -screen 0 1920x1080x24 &"
else echo "virtual screen (for EEVEE plates without a graphics card): Xvfb MISSING (install xvfb)"; fi
command -v xvfb-run >/dev/null && echo "xvfb-run (the place kit draws its local EEVEE pictures and its normals test with it): ok" \
  || echo "xvfb-run (the place kit's local EEVEE pictures and normals test): MISSING (install xvfb; Cycles pictures and every other place verb do not need it)"
if [ -n "${BLENDER_PYTHON:-}" ] && "$BLENDER_PYTHON" -c "import bpy" 2>/dev/null; then
  if "$BLENDER_PYTHON" -c "import PIL" 2>/dev/null; then with="with Pillow"; else with="without Pillow, which the model scripts no longer need"; fi
  echo "blender python module (for the model scripts in paper-film/blender/build_*.py): ok ($BLENDER_PYTHON, $with)"
fi
# rented cards (optional): big pictures go to the person's own rented graphics cards. This only says whether the settings are there. It never prints,
# reads or copies a value, and machine-settings.env never holds one; the render command reads them from the environment when it runs.
if [ -n "${RUNPOD_API_KEY:-}" ] && [ -n "${RUNPOD_ENDPOINT_ID:-}" ]; then
  echo "rented cards (optional, for pictures too big for this computer): your account's settings are set in this shell (values are never shown or saved)"
elif [ -n "${RENDER_SETTINGS_FILE:-}" ] && [ -f "${RENDER_SETTINGS_FILE}" ]; then
  echo "rented cards (optional, for pictures too big for this computer): a settings file is named in RENDER_SETTINGS_FILE (its contents are not read here)"
else
  echo "rented cards (optional, for pictures too big for this computer): no settings in this shell. To use them set RUNPOD_API_KEY and RUNPOD_ENDPOINT_ID (your own account's), or name a file kept outside any git folder in RENDER_SETTINGS_FILE (lines NAME=VALUE: RUNPOD_API_KEY=..., RUNPOD_ENDPOINT_ID=..., and optionally RENDER_STORE_FOLDER=...); 'explainer-film-place rent status' says what is missing"
fi
# a soundtrack
soundtrack=$(find "$TARGET/assets/soundtrack" -maxdepth 1 -type f \( -iname '*.mp3' -o -iname '*.wav' -o -iname '*.flac' -o -iname '*.m4a' \) 2>/dev/null | head -1)
if [ -n "$soundtrack" ]; then echo "soundtrack: $soundtrack"
else echo "soundtrack: none yet (copy music you may use into $TARGET/assets/soundtrack/ before mixing)"; fi

# this machine's settings, for the kit's shell tools
{
  echo "# What this is: this machine's settings for the film kit, written by explainer-film-setup on $(date +%Y-%m-%d)."
  echo "# check-shot.sh and paper-film/blender/tests/run-checker-tests.sh read the KEY=value lines; a setting given"
  echo "# in the environment wins. Run explainer-film-setup again to refresh it (it rewrites this file)."
  [ -n "$blender" ] && echo "BLENDER=$blender" || echo "# BLENDER not found"
  echo "BLENDER_DISPLAY=$display"
  [ -n "$browser" ] && echo "# browser found: $browser (the drawing tools find it themselves)"
  [ -n "$soundtrack" ] && echo "# soundtrack found: $soundtrack"
} > "$TARGET/machine-settings.env"
echo "machine settings: $TARGET/machine-settings.env"

# every kit file the skills name must be in the kit (a skill pointing at a missing file was lesson 1)
python3 -I - "$HERE/skills" "$TARGET" <<'EOF'
import os, re, sys
skills, kit = sys.argv[1], sys.argv[2]
named, missing = set(), []
for folder, _, files in os.walk(skills):
    for name in files:
        if name.endswith('.md'):
            for text in re.findall(r'`([^`\n]+)`', open(os.path.join(folder, name), encoding='utf-8').read()):
                whole = re.sub(r'^(\$\{CLAUDE_PLUGIN_ROOT\}/)?(film-)?kit/', '', text.strip())
                # a whole name with spaces in it ("docs/paper-look - 07 Composing a shot.md"), else each word of a command
                words = [whole] if ' ' in whole and os.path.exists(os.path.join(kit, whole)) else text.split()
                for word in words:
                    word = word.strip('"\'(),;:')
                    word = re.sub(r'^(\$\{CLAUDE_PLUGIN_ROOT\}/)?(film-)?kit/', '', word)
                    if not re.match(r'(paper-film|narration-tools|examples|docs|place-kit)/', word):
                        continue
                    if re.search(r'[<>*{}$]|\bN\b|NAME|CHAPTER|\.\.\.', word) or word.endswith('/') or word.startswith('paper-film/out/'):
                        continue   # a pattern, a folder or something a tool writes, not a kit file
                    named.add(word)
for path in sorted(named):
    if not os.path.exists(os.path.join(kit, path)):
        missing.append(path)
print(f'files the skills name: {len(named)} checked, {len(missing)} missing from the kit' + ('' if not missing else ':'))
for path in missing:
    print(f'  {path}')
EOF
# the project's film kit, when it is on this machine (FILM_KIT, else FILM_PROJECT/film-kit, else the project folder next to the plugins folder,
# as the tests find it): its files changed after the plugin's last copy, by the newest date in kit/kit-sync-notes.md
python3 -I - "$HERE" <<'SYNC'
import datetime, os, re, sys
plugin = sys.argv[1]
project = os.environ.get('FILM_PROJECT') or os.path.normpath(os.path.join(plugin, '..', '..', 'austerity-explainer'))
film_kit = os.environ.get('FILM_KIT') or os.path.join(project, 'film-kit')
if not os.path.isdir(film_kit):
    print('film kit: not on this machine (set FILM_KIT to compare it with the plugin\'s copy)')
    sys.exit(0)
months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
dates = []
for line in open(os.path.join(plugin, 'kit', 'kit-sync-notes.md'), encoding='utf-8'):
    if line.startswith('#'):
        for day, month, year in re.findall(r'\b(\d{1,2}) (' + '|'.join(months) + r') (\d{4})\b', line):
            dates.append(datetime.datetime(int(year), months.index(month) + 1, int(day)))
if not dates:
    print('film kit: kit/kit-sync-notes.md names no copy date, so newer files cannot be listed')
    sys.exit(0)
last = max(dates)
after = (last + datetime.timedelta(days=1)).timestamp()
newer = []
for folder, folders, files in os.walk(film_kit):
    folders[:] = [f for f in folders if f not in ('node_modules', 'out', '.git', '__pycache__', 'assets')]
    for name in files:
        path = os.path.join(folder, name)
        if not name.endswith('.pyc') and os.path.getmtime(path) >= after:
            newer.append(os.path.relpath(path, film_kit))
print(f'film kit ({film_kit}): {len(newer)} file(s) changed after the plugin\'s last copy ({last:%d %B %Y}, kit/kit-sync-notes.md)'
      + (':' if newer else '; nothing to copy'))
for path in sorted(newer)[:15]:
    print(f'  {path}')
if len(newer) > 15:
    print(f'  and {len(newer) - 15} more')
SYNC
echo "next: read the make-explainer-film skill; docs are in $TARGET/docs (start with 'paper-look - 00 START HERE.md')"
